# Monique — ne JAMAIS versionner données, secrets, ni ce qui décrit la machine.

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
app/.venv/
.pytest_cache/
.ruff_cache/
build/

# Secrets & environnement (le coffre vit HORS du dépôt, mais on garde-fou)
*.env
!*.env.example
.monique_secrets/
noms_interdits.txt

# Bac à sable : tout ce que Monique écrit en MODE=test — jamais versionné
monique_shadow.db
monique_shadow.db-journal
monique_shadow.db-wal
monique_shadow.db-shm
*.db
*.db-journal
*.db-wal
*.db-shm

# Spillover : peut contenir des corps de messages (IBAN/RIB) — hors versionnement
spillover/

# Boîte d'envoi des agents : collectée en fin de session, JAMAIS versionnée.
# Le harnais fait `git add -A` avant de calculer le diff, et chaque worktree naît depuis HEAD :
# un message fusionné reviendrait donc dans TOUS les worktrees suivants, où le collecteur le
# republierait à la fin de chaque mission — croissance quadratique du fil injecté en tête de
# prompt de tous les agents. Bug trouvé par le contrôleur le 22/08/2026, reproduit avant correctif.
courrier_sortant/
# Questions d'un agent à son conseil (beecham._porte_consultation) : même raison, même sort.
questions/

# Journaux & logs : activité de la machine, pas du projet
*.log
*_audit*
journal_*.log
journal_*.jsonl

# Config locale machine-spécifique
ty.toml

# OS
.DS_Store
Thumbs.db

# Worktrees jetables de Beecham (hors dépôt de toute façon)
.beecham_worktrees/

# Atelier partagé des agents (données de travail vivantes)
atelier/

# lanceurs locaux machine-specifiques (contiennent un chemin de poste)
app/lancer_monique.vbs

# artefact de bench regeneré à chaque run (source de conflits) — décision Direction 19/08
app/tests/_dernieres_mesures_latence.txt
